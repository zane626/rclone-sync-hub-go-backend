# Copy to .env and replace every value before running docker compose.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_RCLONE_REMOTES=my-remote
AUTH_VIEWER_USERNAME=
AUTH_VIEWER_PASSWORD=
METRICS_BEARER_TOKEN=replace-with-an-independent-32-character-token

# Database secrets.
DB_ROOT_PASSWORD=replace-root-password
DB_APP_PASSWORD=replace-app-password

# Deployment paths. The rclone directory must contain rclone.conf.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TRUSTED_PROXIES=
LOCAL_DATA_DIR=./data/local
RCLONE_CONFIG_DIR=./rclone
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
TASK_RETENTION_DAYS=365
APP_MEMORY_LIMIT=1g
APP_CPUS=2.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_CPUS=2.0
